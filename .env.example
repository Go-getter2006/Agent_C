# 复制成 .env 后填写。.env 不要提交进仓库。

# dev：本机开发和演示；prod：正式环境（必须设置 SECRET_KEY，Cookie 只走 HTTPS）
APP_ENV=dev

# 会话签名、教师 XDOJ 密码的加密都从这把密钥派生。换掉它，已保存的教师密码就解不开了。
# 生成一把：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 数据库。不填时用 data/agent.sqlite3（只适合本机开发）。正式环境用 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://用户:密码@主机:5432/库名
DATABASE_URL=

# 登录。现在只有开发用的方式：账号 + 这里设置的统一口令。不设就登录不了。
# 学生正式怎么登录还在待确认（见 docs/问题清单.md）。
AUTH_MODE=dev
DEV_LOGIN_PASSWORD=

# 大模型（DeepSeek）。不填时对话走规则分析和固定模板，题目和规则判不了的提交不会自动标注。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# XDOJ（试点阶段的数据源；教师也可以在登录页用自己的 XDOJ 账号登记）。
# 只读访问，全局串行，两次请求至少间隔 XDOJ_MIN_INTERVAL 秒（不能低于 0.3）。
# 不填：XDOJ_SERVER_CODE=c 时用 C 语言那台（http://47.92.139.74/xdoj-ssm，见 backend/app/servers.py）
XDOJ_BASE_URL=
XDOJ_USER=
XDOJ_PASS=
XDOJ_SERVER_CODE=c
XDOJ_SERVER_NAME=C 语言
XDOJ_TERM=
XDOJ_MIN_INTERVAL=0.5

# 沙箱。local：在本机限时限内存运行（开发用）；socket：连独立的沙箱容器（docker compose 里已经配好）。
SANDBOX_MODE=local

# 每人每天最多几道小题（待定）
QUIZ_DAILY_LIMIT=3

# 只在 docker compose 部署时用：PostgreSQL 的密码
POSTGRES_PASSWORD=
