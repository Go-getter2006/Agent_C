# 复制成 .env 后填写。.env 不要提交进仓库。

# dev：本机开发和演示；prod：正式环境（必须设置 SECRET_KEY，Cookie 只走 HTTPS）
APP_ENV=dev

# 会话签名、教师 XDOJ 密码的加密都从这把密钥派生。换掉它，已保存的教师密码就解不开了。
# 生成一把：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 数据库。不填时用 data/agent.sqlite3（只适合本机开发）。正式环境用 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://用户:密码@主机:5432/库名
DATABASE_URL=

# 登录。
# 老师：在登录页选“教师”，用自己的 XDOJ 账号登录；登录后系统自动同步他名下的班级和学生名单。
# 学生：账号就是名单里的学号，用 XDOJ 的密码登录；密码只拿去 XDOJ 核对一次，不保存。
# DEV_LOGIN_PASSWORD 只给演示数据用（./run.sh demo），正式使用留空。
# AUTH_MODE=dev 会让真实名单里的学生也能用演示口令登录，只用于开发调试，正式环境保持 xdoj。
AUTH_MODE=xdoj
DEV_LOGIN_PASSWORD=

# 大模型（DeepSeek）。不填时对话走规则分析和固定模板，题目和规则判不了的提交不会自动标注。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# XDOJ。一般不用填：C 语言那台的地址写在 backend/app/servers.py 里，老师在网页上用 XDOJ 账号登录就行。
# 只有想在命令行里测试（login-test、xdoj-probe）时才填账号；地址留空就是 C 语言那台。
# 只读访问，全局串行，两次请求至少间隔 XDOJ_MIN_INTERVAL 秒（不能低于 0.2）。
XDOJ_BASE_URL=
XDOJ_USER=
XDOJ_PASS=
XDOJ_SERVER_CODE=c
XDOJ_SERVER_NAME=C 语言
XDOJ_TERM=
XDOJ_MIN_INTERVAL=0.2
# 数据结构那台 XDOJ 的地址（给出以后再填，例如 http://地址/xdoj-ssm）。填了以后登录页出现课程选择，两门课分开登录。
XDOJ_DS_URL=

# 后台同步（拉名单、作业、提交，标注）默认在网页进程里一起跑。docker compose 里它单独一个容器，那里设成 0。
SYNC_IN_WEB=1

# 沙箱。local：在本机限时限内存运行（开发用）；socket：连独立的沙箱容器（docker compose 里已经配好）。
SANDBOX_MODE=local

# 每人每天最多几道小题（待定）
QUIZ_DAILY_LIMIT=3

# 只在 docker compose 部署时用：PostgreSQL 的密码
POSTGRES_PASSWORD=

# 只在 docker compose --profile https 时用：解析到这台服务器的域名，Caddy 会自动申请 HTTPS 证书
DOMAIN=
