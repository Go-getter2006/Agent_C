# 复制本文件为 .env 后填写。不填 DEEPSEEK_API_KEY 时自动进入模拟模式（不调用大模型，只用来跑通流程）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 教师页和数据导出的口令。不设置时，教师页只允许在本机打开。
TEACHER_TOKEN=

# 监听地址。只在本机用填 127.0.0.1；给校园网内的同学访问时改成 0.0.0.0
HOST=127.0.0.1
PORT=5000

# 设为 1：变式题在本机用 gcc 编译运行测试用例（仅限 Linux，不是安全沙箱，只供本机测试）
ENABLE_CODE_RUNNER=0

# 设为 0：学生页不显示“研究调试信息”
SHOW_DEBUG=1
